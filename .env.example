# Copy to .env (gitignored) and fill in. Never commit .env.
# Postgres from `docker compose up -d db` (host port 5433 so it doesn't clash with a local 5432).
DATABASE_URL=postgresql+psycopg://analyst:analyst@localhost:5433/analyst
# SEC fair-access policy: a real name and contact email, e.g. "Jane Doe jane@example.com".
SEC_USER_AGENT=
# Used from Part 3 on.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AGENT_EFFORT=medium
RERANK=false
